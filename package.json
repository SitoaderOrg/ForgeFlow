{
  "name": "forgeflow",
  "version": "1.0.0",
  "private": true,
  "description": "ForgeFlow: Build, inspect, repair, review. Framework tooling and shared lint configs; apps live in apps/<name>/.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:workflows": "vitest run tests/workflows",
    "lint": "eslint . && prettier --check . && htmlhint \"apps/**/*.html\" --ignore \"**/node_modules/**,**/coverage/**,**/dist/**\"",
    "lint:fix": "eslint . --fix && prettier --write ."
  },
  "license": "MIT",
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-plugin-jsonc": "^2.18.2",
    "htmlhint": "^1.9.2",
    "jsonc-eslint-parser": "^2.4.0",
    "prettier": "^3.9.10",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
